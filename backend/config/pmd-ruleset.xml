<?xml version="1.0" encoding="UTF-8"?>
<!-- PMD rules for Project Pulse: PMD's quickstart set, minus the rules the team has decided not to
     enforce. To drop a rule, add an exclude inside the quickstart reference, with a comment giving
     the reason, for example:

       <exclude name="ControlStatementBraces"/>

     To add a rule from outside quickstart, add its own <rule ref="category/java/..."/> line.
     Every change here is a reviewed decision. -->
<ruleset name="Project Pulse"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>PMD quickstart, with Project Pulse's decisions.</description>
    <rule ref="rulesets/java/quickstart.xml">
        <!-- D2: narrowed below, not dropped. -->
        <exclude name="UncommentedEmptyConstructor"/>
        <exclude name="UnnecessaryConstructor"/>
        <!-- D4: GuardLogStatement is off. Project Pulse logs only through SLF4J with {} placeholders,
             so the message string is built only when the level is enabled; the guard would save
             nothing but evaluating the arguments. All 4 findings on 2026-11-01 passed plain getters
             or size() (student.getEmail(), templates.size(), authentication.getName(), ...), and 3
             of the 4 are at info or error, which are on in production, so an isXEnabled() guard
             there would always be true. Check: grep for LoggerFactory finds only org.slf4j loggers,
             and no log call in backend/src/main builds its message by string concatenation. -->
        <exclude name="GuardLogStatement"/>
    </rule>

    <!-- D2: UncommentedEmptyConstructor and UnnecessaryConstructor are off in JPA entities and enforced
         everywhere else. 34 of the 40 findings on 2026-11-01 were the no-arg constructor of an @Entity.
         The JPA spec requires every entity to have one (public or protected), and Hibernate calls it
         reflectively, so it is never "unnecessary": deleting it, which is what UnnecessaryConstructor
         asks, compiles today and fails at startup the day someone adds a second constructor. A comment
         in each would only repeat what @Entity already says. The other 6 findings were in plain
         classes (PeerEvaluationAverage, RatingAverage, WeeklyPeerEvaluationReport, Result) where
         nothing needs the empty constructor; those were fixed, and the rules stay on for such classes.
         Check: the XPath matches a constructor only inside a class annotated @Entity. -->
    <rule ref="category/java/documentation.xml/UncommentedEmptyConstructor">
        <properties>
            <property name="violationSuppressXPath"
                      value="./ancestor::ClassDeclaration[ModifierList/Annotation[@SimpleName = 'Entity']]"/>
        </properties>
    </rule>
    <rule ref="category/java/codestyle.xml/UnnecessaryConstructor">
        <properties>
            <property name="violationSuppressXPath"
                      value="./ancestor::ClassDeclaration[ModifierList/Annotation[@SimpleName = 'Entity']]"/>
        </properties>
    </rule>
</ruleset>
